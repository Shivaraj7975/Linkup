# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=linkup_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# JWT Authentication Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Google Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here

# NVIDIA Nemotron AI Integration
NVIDIA_API_KEY=your_nvidia_api_key_here
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# New AI Waterfall Providers
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

NVIDIA_LLAMA_API_KEY=your_nvidia_llama_api_key_here
NVIDIA_LLAMA_MODEL=meta/llama-3.1-8b-instruct

VOIDAI_API_KEY=your_voidai_api_key_here
VOIDAI_MODEL=gpt-4o-mini

# AI Waterfall Configuration
AI_PROVIDER_ORDER=groq,nvidia_llama,voidai,nvidia_nemotron,gemini
AI_PROVIDER_TIMEOUT_MS=7000
AI_PROVIDER_COOLDOWN_MS=60000

# Brevo Email Integration (Replace xsmtpsib-... with your real Brevo SMTP Key)
BREVO_API_KEY=xsmtpsib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=your_brevo_smtp_login@example.com
SENDER_EMAIL=your_brevo_smtp_login@example.com
SENDER_NAME=Linkup Platform
